# A pairing code is generated at server startup if this is empty.
PAIRING_CODE=
# Enable simulator output only after verifying input direction and ranges.
XPLANE_OUTPUT_ENABLED=false
# Use the IP address of the machine running X-Plane.
XPLANE_HOST=127.0.0.1
XPLANE_PORT=49000
XPLANE_PROBE_ENABLED=true
# Local development defaults to 127.0.0.1:3000 without TLS.
# For iPhone testing, create trusted TLS certificates and use 0.0.0.0:8443.
HOST=127.0.0.1
PORT=3000
TLS_CERT_FILE=
TLS_KEY_FILE=

# Native plugin bridge (optional; default remains X-Plane UDP).
# Use 'native' only after installing the C++ plugin in X-Plane.
XPLANE_TRANSPORT=udp
# Generate using: openssl rand -hex 24
# The same secret must be configured in the plugin's controller.conf.
NATIVE_SHARED_TOKEN=
NATIVE_PLUGIN_PORT=49051
NATIVE_LISTEN_PORT=49052
# Use 0.0.0.0 only when X-Plane runs on another trusted computer.
NATIVE_LISTEN_HOST=127.0.0.1
